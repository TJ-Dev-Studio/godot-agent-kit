#!/usr/bin/env bash
# gak — Godot Agent Kit
#
# Unified CLI for AI agents working with Godot projects.
# Routes to sub-tools: preview, interact, (future: audio, perf, etc.)
#
# Usage:
#   gak init [project-path]       — install skills into a Godot project
#   gak preview capture <project> <scene> [options]
#   gak interact <project> <scene> --actions <file> [options]
#   gak setup [--tools-dir <path>]

set -euo pipefail

GAK_DIR="$(cd "$(dirname "$0")" && pwd)"
TOOLS_DIR="${GAK_TOOLS_DIR:-$GAK_DIR/tools}"

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

err() { echo -e "${RED}[gak]${NC} $*" >&2; }
log() { echo -e "${CYAN}[gak]${NC} $*"; }
ok()  { echo -e "${GREEN}[gak]${NC} $*"; }

usage() {
    cat <<'EOF'
gak — Godot Agent Kit

AI-agent toolkit for visual iteration on Godot 4 projects.

COMMANDS:
  init       Install GAK skills into a Godot project (run once per project)
  preview    Capture rendered screenshots from scenes (wraps godot-preview)
  interact   Simulate player input and capture results (wraps godot-interact)
  mgw        GitHub issue-to-PR automation (wraps mgw)
  setup      Install/update sub-tools
  tools      List installed tools
  help       Show this help

USAGE:
  gak init [project-path]
  gak preview capture <project> <scene> [options]
  gak interact <project> <scene> --actions <actions.json> [options]
  gak mgw issues|run|status|sync|pr|milestone|init|next [args]
  gak setup

EXAMPLES:
  # Capture a lobby scene at phone resolution
  gak preview capture ./godot_project res://scenes/lobby.tscn

  # Simulate a touch-drag and capture the result
  gak interact ./godot_project res://scenes/lobby.tscn \
    --actions '{"actions":[{"type":"wait","seconds":2},{"type":"drag","from":[540,960],"to":[200,960],"duration":1}]}'

  # GitHub issue-to-PR automation
  gak mgw issues
  gak mgw run 42
  gak mgw status

  # Setup tools (clones sub-repos if needed)
  gak setup

ENVIRONMENT:
  GODOT_BIN       Path to Godot binary
  GAK_TOOLS_DIR   Override tools directory (default: <gak-dir>/tools)

SUB-TOOL REPOS:
  godot-preview   → tools/godot-preview/   (visual capture)
  godot-interact  → tools/godot-interact/  (input simulation)
  mgw             → tools/mgw/            (GitHub issue-to-PR automation)
EOF
}

# Resolve a tool path — checks tools/ dir for the tool
resolve_tool() {
    local tool_name="$1"
    local tool_dir="$TOOLS_DIR/$tool_name"
    local script_name=""

    case "$tool_name" in
        preview|godot-preview)
            tool_dir="$TOOLS_DIR/godot-preview"
            script_name="godot_preview.sh"
            ;;
        interact|godot-interact)
            tool_dir="$TOOLS_DIR/godot-interact"
            script_name="godot_interact.sh"
            ;;
        mgw)
            tool_dir="$TOOLS_DIR/mgw"
            script_name="bin/mgw.cjs"
            ;;
        *)
            err "Unknown tool: $tool_name"
            exit 1
            ;;
    esac

    if [[ -x "$tool_dir/$script_name" ]]; then
        echo "$tool_dir/$script_name"
    else
        err "Tool not installed: $tool_name"
        err "Run 'gak setup' to install tools, or place them in $TOOLS_DIR/"
        exit 1
    fi
}

cmd_setup() {
    log "Setting up Godot Agent Kit tools..."
    mkdir -p "$TOOLS_DIR"

    # godot-preview
    if [[ -d "$TOOLS_DIR/godot-preview" ]]; then
        log "godot-preview: updating..."
        (cd "$TOOLS_DIR/godot-preview" && git pull --quiet 2>/dev/null) || true
    else
        log "godot-preview: cloning..."
        git clone --quiet https://github.com/TJ-Dev-Studio/godot-preview.git "$TOOLS_DIR/godot-preview" 2>/dev/null || {
            warn "Could not clone godot-preview. You can manually place it in $TOOLS_DIR/godot-preview/"
        }
    fi

    # godot-interact
    if [[ -d "$TOOLS_DIR/godot-interact" ]]; then
        log "godot-interact: updating..."
        (cd "$TOOLS_DIR/godot-interact" && git pull --quiet 2>/dev/null) || true
    else
        log "godot-interact: cloning..."
        git clone --quiet https://github.com/TJ-Dev-Studio/godot-interact.git "$TOOLS_DIR/godot-interact" 2>/dev/null || {
            warn "Could not clone godot-interact. You can manually place it in $TOOLS_DIR/godot-interact/"
        }
    fi

    # mgw
    if [[ -d "$TOOLS_DIR/mgw" ]]; then
        log "mgw: updating..."
        (cd "$TOOLS_DIR/mgw" && git pull --quiet 2>/dev/null) || true
    else
        log "mgw: cloning..."
        git clone --quiet https://github.com/snipcodeit/mgw.git "$TOOLS_DIR/mgw" 2>/dev/null || {
            warn "Could not clone mgw. You can manually place it in $TOOLS_DIR/mgw/"
        }
    fi
    # mgw needs npm deps (commander)
    if [[ -d "$TOOLS_DIR/mgw" ]] && [[ ! -d "$TOOLS_DIR/mgw/node_modules" ]]; then
        log "mgw: installing dependencies..."
        (cd "$TOOLS_DIR/mgw" && npm install --silent 2>/dev/null) || true
    fi

    ok "Setup complete. Installed tools:"
    cmd_tools
}

cmd_tools() {
    for tool_dir in "$TOOLS_DIR"/*/; do
        if [[ -d "$tool_dir" ]]; then
            local name
            name="$(basename "$tool_dir")"
            local status="installed"
            # Check for main script
            if [[ -x "$tool_dir/godot_preview.sh" ]] || [[ -x "$tool_dir/godot_interact.sh" ]] || [[ -f "$tool_dir/bin/mgw.cjs" ]]; then
                status="${GREEN}ready${NC}"
            else
                status="${RED}missing script${NC}"
            fi
            echo -e "  $name  $status"
        fi
    done
}

cmd_preview() {
    local tool
    tool="$(resolve_tool preview)"
    exec "$tool" "$@"
}

cmd_interact() {
    local tool
    tool="$(resolve_tool interact)"
    exec "$tool" "$@"
}

cmd_mgw() {
    local tool
    tool="$(resolve_tool mgw)"
    exec node "$tool" "$@"
}

cmd_init() {
    local target_dir="${1:-.}"
    target_dir="$(cd "$target_dir" && pwd)"

    # Compute relative path from target to GAK
    local gak_rel
    gak_rel="$(python3 -c "import os; print(os.path.relpath('$GAK_DIR', '$target_dir'))")"

    log "Installing GAK skills into $target_dir"
    log "GAK location: $gak_rel/ (relative to target)"

    # Ensure sub-tools are installed
    if [[ ! -d "$TOOLS_DIR/godot-preview" ]]; then
        log "Sub-tools not found. Running setup first..."
        cmd_setup
    fi

    # Ensure npm deps are installed
    if [[ ! -d "$GAK_DIR/node_modules" ]]; then
        log "Installing Node.js dependencies..."
        (cd "$GAK_DIR" && npm install --silent 2>/dev/null) || {
            err "npm install failed. Ensure Node.js 18+ is installed."
            exit 1
        }
    fi

    local skills_dir="$target_dir/.claude/skills"
    mkdir -p "$skills_dir"

    # --- preview-capture ---
    mkdir -p "$skills_dir/preview-capture"
    cat > "$skills_dir/preview-capture/SKILL.md" <<SKILL
---
name: preview-capture
description: Capture a rendered screenshot of a Godot 4 scene as PNG. Use when you need to see what a scene looks like, verify visual changes, or check camera/lighting/layout. Works without display access.
argument-hint: <project-path> <scene-path> [options]
allowed-tools: Bash(npx tsx *), Read
---

# Preview Capture

Render a Godot 4 scene and extract a PNG screenshot.

## Run

\`\`\`bash
npx tsx ${gak_rel}/src/preview-capture.ts \$ARGUMENTS
\`\`\`

Returns structured JSON:
\`\`\`json
{"success": true, "output_path": "/tmp/godot-preview/lobby.png", "scene": "res://scenes/lobby.tscn", "resolution": "1080x1920", "frame": 5, "warnings": [], "errors": []}
\`\`\`

After capture, read the output PNG with the Read tool to see the rendered scene.

## Options
- \`-r, --resolution WxH\` (default: 1080x1920) — viewport resolution
- \`-f, --frame N\` (default: 5) — frame to extract (0 is often blank)
- \`-s, --seconds N\` (default: 10) — render duration
- \`--fps N\` (default: 1) — render FPS
- \`-o, --output PATH\` — custom output path
- \`-v, --verbose\` — include Godot log

## Tips
- Frame 0 is often blank — use frame 3-5 for a settled scene
- Use 1080x1920 for portrait mobile, 1280x720 for landscape
- Increase --seconds for scenes with animations or orbit cameras
SKILL

    # --- preview-list ---
    mkdir -p "$skills_dir/preview-list"
    cat > "$skills_dir/preview-list/SKILL.md" <<SKILL
---
name: preview-list
description: List all .tscn scene files in a Godot project. Use when you need to discover what scenes are available before capturing or interacting with them.
argument-hint: <project-path>
allowed-tools: Bash(npx tsx *)
---

# List Godot Scenes

\`\`\`bash
npx tsx ${gak_rel}/src/preview-list.ts \$ARGUMENTS
\`\`\`

Returns structured JSON with scene paths in res:// format.
SKILL

    # --- interact ---
    mkdir -p "$skills_dir/interact"
    cat > "$skills_dir/interact/SKILL.md" <<SKILL
---
name: interact
description: Simulate player input (touch, drag, key press, scroll) in a Godot 4 scene and capture the result as PNG. Use when you need to test how a scene responds to user interaction.
argument-hint: <project-path> <scene-path> --actions <json> [options]
allowed-tools: Bash(npx tsx *), Read
---

# Interact — Simulate Input and Capture

\`\`\`bash
npx tsx ${gak_rel}/src/interact.ts \$ARGUMENTS
\`\`\`

## Action JSON Format
\`\`\`json
{
  "actions": [
    {"type": "wait", "seconds": 2},
    {"type": "touch", "position": [540, 960]},
    {"type": "drag", "from": [540, 960], "to": [200, 960], "duration": 0.5},
    {"type": "key", "key": "ui_accept"},
    {"type": "scroll", "position": [540, 960], "direction": "up", "amount": 3}
  ]
}
\`\`\`

After interaction, read the output PNG to see the result.

## Options
- \`-r, --resolution WxH\` (default: 1080x1920)
- \`-s, --seconds N\` (default: 15) — total render time
- \`--fps N\` (default: 2)
- \`--capture WHEN\` (default: last)
- \`-v, --verbose\`
SKILL

    # --- setup ---
    mkdir -p "$skills_dir/setup"
    local gak_repo_url
    gak_repo_url="$(cd "$GAK_DIR" && git remote get-url origin 2>/dev/null || echo "https://github.com/TJ-Dev-Studio/godot-agent-kit.git")"
    cat > "$skills_dir/setup/SKILL.md" <<SKILL
---
name: gak-setup
description: Install or update GAK sub-tools and dependencies. Run this if preview/interact skills fail with missing tools. Self-bootstrapping — clones GAK if not present.
disable-model-invocation: true
allowed-tools: Bash(git clone *), Bash(${gak_rel}/gak *), Bash(npm *), Bash(cd *)
---

# GAK Setup

First-time setup or update. Handles cloning GAK if not present.

\`\`\`bash
if [ ! -d "${gak_rel}" ]; then git clone ${gak_repo_url} ${gak_rel}; fi && ${gak_rel}/gak setup && (cd ${gak_rel} && npm install)
\`\`\`

Requires: Godot 4.x, ffmpeg, Node.js 18+, git.

## Auto-Update

GAK auto-updates itself and all sub-tools on first skill invocation per session (1hr cooldown). No manual update commands needed.
SKILL

    # --- mgw ---
    mkdir -p "$skills_dir/mgw"
    cat > "$skills_dir/mgw/SKILL.md" <<SKILL
---
name: mgw
description: "GitHub issue-to-PR automation. Triage issues, plan work, execute autonomously, and create pull requests. Use when working with GitHub issues or automating the development pipeline."
argument-hint: <subcommand> [args]
allowed-tools: Bash(npx tsx *), Bash(node *), Bash(gh *), Read, Write, Edit
---

# MGW — Issue In, PR Out

GitHub-native issue-to-PR automation for Claude Code.

\`\`\`bash
npx tsx ${gak_rel}/src/mgw.ts \$ARGUMENTS
\`\`\`

Returns structured JSON with success/errors/warnings.

## Subcommands

### Discovery & Triage
- \`issues\` — list/filter GitHub issues
- \`issue <n>\` — deep five-dimension triage analysis
- \`next\` — show next unblocked issue

### Execution
- \`run <n>\` — full autonomous pipeline: triage → plan → execute → verify → PR
- \`milestone [n]\` — execute entire milestone in dependency order

### Project Management
- \`status [n]\` — project dashboard / issue status
- \`sync\` — reconcile local .mgw/ state with GitHub
- \`init\` — bootstrap repo for MGW usage
- \`project\` — scaffold milestones and issues from descriptions

### Output
- \`pr [n]\` — create PR from completed work artifacts
- \`update <n>\` — post structured status comment to GitHub
- \`review <n>\` — classify new comments on an issue
- \`link <ref> <ref>\` — cross-reference issues and PRs

## Flags
- \`--json\` — machine-readable output
- \`--force\` — override triage gate
- \`--dry-run\` — preview without executing
- \`--base <branch>\` — set PR target branch
SKILL

    # --- visual-iteration (model-only) ---
    mkdir -p "$skills_dir/visual-iteration"
    cat > "$skills_dir/visual-iteration/SKILL.md" <<SKILL
---
name: visual-iteration
description: Knowledge about the Godot visual iteration workflow — capture, inspect, edit, re-capture loop. Use when working with .tscn or .gd files.
user-invocable: false
---

# Godot Visual Iteration

1. Read .tscn/.gd files to understand the scene
2. /preview-capture <project> <scene> to render to PNG
3. Read the output PNG to see the rendered 3D result
4. Identify issues (camera, lighting, layout)
5. Edit source files to fix
6. Capture again to verify

Use /interact to test how scenes respond to player input.
SKILL

    ok "Skills installed to $skills_dir/"
    ok ""
    ok "Skills available:"
    echo -e "  ${GREEN}/preview-capture${NC}  — render scene to PNG"
    echo -e "  ${GREEN}/preview-list${NC}     — list project scenes"
    echo -e "  ${GREEN}/interact${NC}         — simulate input + capture"
    echo -e "  ${GREEN}/mgw${NC}              — GitHub issue-to-PR automation"
    echo -e "  ${GREEN}/gak-setup${NC}        — install/update tools"
    echo ""
    ok "Claude auto-discovers visual-iteration knowledge."
    ok "Done! Fire up Claude Code and start building."
}

# --- Main ---
case "${1:-help}" in
    preview) shift; cmd_preview "$@" ;;
    interact) shift; cmd_interact "$@" ;;
    mgw) shift; cmd_mgw "$@" ;;
    init) shift; cmd_init "$@" ;;
    setup) shift; cmd_setup "$@" ;;
    tools) cmd_tools ;;
    help|-h|--help) usage ;;
    *) err "Unknown command: $1"; echo; usage; exit 1 ;;
esac
